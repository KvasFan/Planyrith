# A new height, then rolled back before the extrusion.
part-create --name Plate
parameter-set --component Plate --name height --formula 20
feature-add --part instance --command rectangle --params '{"corner_a":[0,0,0],"corner_b":[400,200,0]}'
feature-add --part instance --command push-pull --label Extrude --params '{"face":{"Query":"face & last"},"distance":"=height"}'
parameter-set --component Plate --name height --formula 35
part-regenerate --part instance
part-regenerate --part instance --rollback-before 2
