# Export a box to STL, erase it, import it back as a group and as a component.
rectangle --corner-a 0,0,0 --corner-b 600,400,0
push-pull --face '{face & last}' --distance 300
export --path exports/import-box.stl
erase --targets all
import --path exports/import-box.stl
import --path exports/import-box.stl --as component:Box --at 1000,0,0 --file-units cm --scale 0.1
