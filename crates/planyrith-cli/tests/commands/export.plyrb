# Export a textured box as STL (binary and ASCII), OBJ, glTF/GLB, DXF, a
# native copy, a component report and drawings of the view (the document
# is unchanged).
material-create --name Oak --color '#A0522D' --texture textures/oak.png
rectangle --corner-a 0,0,0 --corner-b 600,400,0
push-pull --face '{face & last}' --distance 300
material-apply --targets 'face & normal:z' --material Oak
make-component --targets all --name Crate
export --path exports/box.stl
export --path exports/box-ascii.stl --ascii --file-units m --z-up
export --path exports/box.obj
export --path exports/box.gltf
export --path exports/box.glb
export --path exports/box.plyr
export --path exports/box.dxf --file-units m
export --path exports/report.csv --file-units cm
export --path exports/view.svg
export --path exports/view.pdf --paper-width 420mm
export --path exports/view.dxf --two-d
