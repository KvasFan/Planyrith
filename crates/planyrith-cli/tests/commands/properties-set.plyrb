# A bracket component given a part number, a description and properties.
rectangle --corner-a 0,0,0 --corner-b 100,40,0
push-pull --face '{face & last}' --distance 5
make-component --targets all --name Bracket
properties-set --params-json '{"target":"instance","part_number":"BR-100","description":"Steel bracket","properties":{"material":"S235","finish":"zinc"}}'
