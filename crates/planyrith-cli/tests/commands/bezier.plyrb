# An open S-curve, then a closed two-span outline that forms a face.
bezier --points 0,0,0 --points 0,500,0 --points 500,500,0 --points 500,1000,0 --segments 8
bezier --points 1000,0,0 --points 1300,0,0 --points 1500,300,0 --points 1500,600,0 --points 1500,900,0 --points 1000,900,0 --points 1000,0,0 --segments 6
