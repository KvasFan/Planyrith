# A cabinet's width as a parameter.
rectangle --corner-a 0,0,0 --corner-b 18,400,0
push-pull --face '{face & last}' --distance 700
make-group --targets 'edge | face' --name Left
rectangle --corner-a 18,0,300 --corner-b 582,400,300
push-pull --face '{face & last}' --distance 18
make-group --targets 'edge | face' --name Shelf
make-component --targets group --name Cabinet
parameter-set --component Cabinet --name width --formula 800
parameter-set --component Cabinet --name board --formula 18mm
